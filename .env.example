# Groq by default; alternatives: mistral, openrouter, google, openai, dry (offline).
MODEL_PROVIDER=groq

# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Mistral (alternative): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# OpenRouter (optional): select MODEL_PROVIDER=openrouter explicitly.
# Free accounts currently share 50 requests/day across all free models.
# Pricing and limits: https://openrouter.ai/pricing
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Server-side backup; leave empty to disable model fallback.
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Google AI Studio (optional): select MODEL_PROVIDER=google explicitly.
# Key: https://aistudio.google.com/apikey
# Free quotas vary by project/model: https://ai.google.dev/gemini-api/docs/rate-limits
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# OpenAI (optional, paid): select MODEL_PROVIDER=openai explicitly.
# Key and billing: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OpenAI runs with reasoning disabled to preserve the sampling exercises.

# Service controls (token prices are configured, not fetched from the provider)
CACHE_TTL_SECONDS=300
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=30
INPUT_USD_PER_MILLION_TOKENS=0
OUTPUT_USD_PER_MILLION_TOKENS=0
